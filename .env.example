# ==============================================================================
# NVK 3D AI OS - Environment Configuration Template
# ==============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Default AI Provider & Model Configuration
# ------------------------------------------------------------------------------
# Primary provider: "gemini" | "openai" | "anthropic" | "deepseek" | "mistral" | "openrouter" | "groq" | "together" | "nvidia" | "ollama"
DEFAULT_AI_PROVIDER=gemini

# Google Gemini API Keys & Models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
IMAGEN_MODEL=imagen-3.0-generate-002

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# DeepSeek Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mistral AI Configuration
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Together AI Configuration
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# NVIDIA Integrated API Configuration
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k2.5

# Local Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
